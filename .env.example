# Шаблон конфигурации inknet-hybrid: скопировать в .env и править под себя.
# Значения здесь — дефолты; Makefile подставляет их в команды, разовые
# переопределения: make ds-merged ARGS="--dry-run".
# Модель распознавания (line_int8) живёт в ../inknet-train: обучение,
# дообучение и экспорт ONNX делаются там, здесь — сбор данных и веб-приложение.
WEB_ONNX=jsnet                       # корень для билдера (имя переменной задано
                                     # parity-зафиксированным скриптом): jsnet — самодостаточный
                                     # vendor-слой: копии экстракторов + снимок базы написаний
                                     # (jsnet/db/app.db) + vocab/terms
NODE=node                            # node для скриптов датасета/merge
ONLINE=../inknet-online              # соседний репозиторий для гейта make parity
DATA_DIR=data/line-vectors-m         # дефолт проекта: person-disjoint датасет (фолды по
                                     # людям); логин-разрез data/line-vectors протекает по
                                     # почерку (правило 7), он только для make ds/FORCE_MERGED=1
# --- параметры скрипта датасета (как в inknet-online) ---
MIN_WRITER_CHARS=10                  # минимальное покрытие букв у автора
LINES=150                            # обучающих строк на автора в фолд
TEST_LINES=120                       # тестовых строк на тест-автора (30 даёт шум
                                     # CER ±0.1, что больше эффекта любых сравнений)
MULTIWORD_PROB=0.4                   # доля двухсловных строк
# --- person-disjoint разрез (make merge / ds-merged) ---
# за одним человеком в базе закреплено несколько логинов (сдача с iPad и планшета),
# билдер группирует по логину → фолды пересекаются по людям. Склеиваем логины в
# снимке базы, билдер не правим (гейт make parity).
MERGED_DB=data/db/app-merged.db      # снимок app.db со склейкой (gitignored)
WRITERS_MAP=scripts/writers-merge.json  # логин -> канонический автор
DATA_DIR_M=data/line-vectors-m       # датасет по людям
# ВНИМАНИЕ: DATA_DIR выше = person-disjoint разрез. Цель логин-разреза (ds)
# пишет именно туда, поэтому в Makefile на ней стоит guard-merged: она
# откажется затирать датасет по людям. По людям — ds-merged.
# --- веб-приложение jsnet (make up — фоновый демон; down / status / log) ---
# адрес прослушивания: 0.0.0.0 — доступ по сети (планшет), только для своей сети
WEB_HOST=127.0.0.1
WEB_PORT=3210
# сервер принимает PORT/HOST (их подставляет make); COOKIE_SECURE=1 — ставить,
# если заходите через HTTPS/прокси (иначе cookie сессии уходят по HTTP)
# --- серверный профиль (systemd + nginx + TLS): node слушает только 127.0.0.1,
# TLS терминирует прокси; база выносится из кодового дерева (бэкап — sqlite3
# .backup, не cp: WAL-режим). Плагин-юниты и nginx — этап 2 (deploy/).
# WEB_HOST=127.0.0.1
# COOKIE_SECURE=1
# DB_PATH=/var/lib/inknet/app.db
