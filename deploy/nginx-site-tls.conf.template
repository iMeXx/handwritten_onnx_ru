# Конфиг для режима готовых сертификатов (install.sh --cert/--key), например
# wildcard-сертификат *.imx.work.gd в /etc/nginx/ssl. certbot-режим живёт в
# nginx-site.conf.template (listen 80, certbot --nginx --redirect дорисует TLS).
# Приложение слушает только 127.0.0.1:__PORT__; наружу — только HTTPS.
#
# Важно для планшета: POST /api/train — большие тела (целые сессии написаний),
# client_max_body_size занижать нельзя. sw.js отдаём без кэша: старый
# service worker = заклинивший клиент.

limit_req_zone $binary_remote_addr zone=ink_api:10m rate=8r/s;

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name __DOMAIN__;

    ssl_certificate __CERT__;
    ssl_certificate_key __KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=63072000" always;
    add_header X-Content-Type-Options nosniff always;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript;

    # сессия написаний одним POST (см. шапку файла)
    client_max_body_size 64m;

    # вход по имени без пароля — только за TLS; rate-limit на API
    location /api/ {
        limit_req zone=ink_api burst=20 nodelay;
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location = /sw.js {
        add_header Cache-Control "no-cache";
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_set_header Host $host;
    }

    # модели .onnx/.ort ~18 МБ — gzip не нужен (бинарные, кэшируются SW)
    location / {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
