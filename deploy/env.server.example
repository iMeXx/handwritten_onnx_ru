# /etc/inknet/env — EnvironmentFile для systemd (inknet-web, inknet-backup).
# Формат: ТОЛЬКО KEY=VALUE; инлайн-комментарии запрещены (systemd не срезает
# хвост после значения, в отличие от make — значения поедут с мусором).
# Права: root:inknet 640 (файл в /etc/inknet, ставит install.sh).

# jsnet/server/index.js слушает только localhost: наружу — nginx + TLS
HOST=127.0.0.1
PORT=4173

# cookie сессии только по HTTPS (сервер за TLS-прокси — обязательный режим)
COOKIE_SECURE=1

# база вынесена из кодового дерева: права inknet, бэкап — sqlite3 .backup
DB_PATH=/var/lib/inknet/app.db

# статистика/гейты билдера (статистика на /stats честна по тем же порогам)
MIN_WRITER_CHARS=10

# обучение на сервере НЕ делается (решение проекта): torch и обучение живут
# на dev-машине, веса публикуются на сервер как код (jsnet/public/models/)
